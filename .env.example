# =============================================================
#  AXCENMUSIC — Variables de configuración
#  Copia este archivo a .env y rellena tus valores:
#    cp .env.example .env && nano .env
# =============================================================

# --- DIRECTORIO DE MÚSICA ---
# Ruta donde está (o estará montado) el almacenamiento con tu música.
# HDD externo USB:      /mnt/music
# MicroSD adicional:    /mnt/music   (misma ruta, distinto dispositivo)
MUSIC_DIR=/mnt/music

# UUID del dispositivo de almacenamiento (obtener con: sudo blkid)
# Ejemplo: a1b2c3d4-e5f6-7890-abcd-ef1234567890
STORAGE_UUID=RELLENAR_CON_BLKID

# Tipo de sistema de ficheros del dispositivo (ext4, exfat, ntfs, vfat)
STORAGE_FSTYPE=ext4

# --- NAVIDROME ---
# Puerto en el que escucha Navidrome (accesible dentro de la red Tailscale)
ND_PORT=4533

# Directorio de datos de Navidrome (base de datos, caché)
ND_DATA_DIR=./navidrome-data

# Frecuencia de escaneo de nuevas canciones
# Formatos: @every 30m | @every 1h | @daily | @hourly | 0 (desactivado)
ND_SCAN_SCHEDULE=@every 1h

# Nivel de log: debug | info | warn | error
ND_LOG_LEVEL=info

# Tiempo de sesión antes de pedir login de nuevo
ND_SESSION_TIMEOUT=24h

# --- TAILSCALE ---
# Auth key para registro automático (sin requerir navegador).
# Generar en: https://login.tailscale.com/admin/settings/keys
# Usa una "auth key" de tipo reusable+ephemeral=false para un servidor fijo.
TAILSCALE_AUTH_KEY=tskey-auth-RELLENAR

# Hostname que verás en tu red Tailscale
TAILSCALE_HOSTNAME=pimusic

# --- SSH / SFTP ---
# Puerto SSH del servidor (22 por defecto).
# Cámbialo a 2222 u otro si quieres menos ruido en logs, aunque con
# Tailscale el acceso ya está bastante limitado.
SSH_PORT=22

# Usuario SSH principal de la Pi (normalmente "pi")
PI_USER=pi

# --- NOTIFICACIONES (ntfy.sh) ---
# Topic al que se enviarán notificaciones de backup, actualizaciones, descargas, etc.
# 1. Instala la app "ntfy" en el iPhone (App Store, gratis)
# 2. Elige un nombre único para tu topic (ej: axcenmusic-abc123)
# 3. Suscríbete a ese topic en la app
# Déjalo vacío para desactivar las notificaciones.
NTFY_TOPIC=

# --- COLA DE DESCARGAS WEB ---
# Puerto de la interfaz web para descargar música desde el iPhone
# Accesible en http://pimusic:8888 (solo via Tailscale)
WEBQUEUE_PORT=8888

# --- PANEL DE INICIO (HUB) ---
# Puerto del panel con tarjetas de acceso a todas las apps (homepage/index.html).
# Tras ejecutar 09-setup-funnel.sh queda público en https://<tailnet>:10000
# Añade esa URL a la pantalla de inicio del iPhone para tener un solo icono
# con acceso a Navidrome, WebQueue, Lidarr, Prowlarr, etc.
HOMEPAGE_PORT=7575

# Usuario y contraseña de administrador de Navidrome.
# Si los rellenas, aparece el botón "Escanear biblioteca" en la interfaz web.
ND_ADMIN_USER=
ND_ADMIN_PASS=

# Límite de tamaño para subidas de archivos desde el navegador (en MB).
MAX_UPLOAD_MB=500

# --- SPOTIFY (opcional, para importar playlists) ---
# Crea una app gratuita en https://developer.spotify.com/dashboard
# Redirect URI: http://localhost (cualquier valor sirve)
SPOTIFY_CLIENT_ID=RELLENAR
SPOTIFY_CLIENT_SECRET=RELLENAR

# --- SOULSEEK + LIDARR + PROWLARR + EDITOR DE TAGS (opcional) ---
# Se configuran con: sudo bash scripts/10-setup-media-stack.sh
# Solo accesibles dentro de tu red Tailscale (no se exponen por Funnel).
MUSIC_TAG_PORT=6677
LIDARR_PORT=8686
PROWLARR_PORT=9696
SLSKD_PORT=5030

# Carpeta donde Lidarr deja los álbumes descargados antes de moverlos
DOWNLOADS_DIR=/mnt/music/downloads

# Zona horaria de los contenedores de Lidarr/Prowlarr
TZ=Europe/Madrid
